    "@angular/fire": "~21.0.0-rc.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@ngrx/signals": "~21.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "ajv": "^8.20.0",
    "chart.js": "~4.4.0",
    "firebase": "~11.0.0",
    "material-symbols": "^0.44.12",
    "ng2-charts": "~10.0.0",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.0",
    "sweetalert2": "~11.10.0",
