  "description": "Income & expense management app — modernized to Angular 21 standalone + signals (ecosystem-compatible: AngularFire 21, NgRx Signals 21, ng2-charts 10)",
  "scripts": {
    "ng": "ng",
    "start": "NODE_OPTIONS=\"--no-deprecation\" ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
